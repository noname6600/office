# ============================================================
# Google OAuth (Web application client — tạo trong Google Cloud Console)
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Phải khớp chính xác với Authorized redirect URI đã đăng ký trên Google Cloud Console
GOOGLE_REDIRECT_URI=https://your-internal-server/auth/callback

# ============================================================
# Bảo mật
# ============================================================
# Dùng để ký session cookie — chuỗi bất kỳ, càng dài càng tốt
SESSION_SECRET_KEY=change-me-session-secret

# true khi chạy sau HTTPS (Caddy/nginx) — bắt buộc bật khi deploy thật, để false khi chạy local http
SESSION_HTTPS_ONLY=false

# Dùng để mã hoá access/refresh token lưu trong DB — PHẢI là Fernet key hợp lệ.
# Tạo bằng: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ============================================================
# Database
# ============================================================
DATABASE_URL=sqlite:///./app.db

# ============================================================
# Deploy Docker (chỉ cần khi chạy docker-compose)
# ============================================================
# Domain trỏ DNS về VPS này — Caddy dùng để tự lấy chứng chỉ HTTPS (Let's Encrypt)
DOMAIN=your-domain.com
